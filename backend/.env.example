# monthTrack - Configuração

# Senha de acesso ao app. Se não for definida, uma senha aleatória
# será gerada e exibida no console na primeira execução.
APP_PASSWORD=minha_senha_secreta

# Diretório onde os arquivos .md de dados serão armazenados.
# Pode ser relativo ao diretório backend/ ou um caminho absoluto.
DATA_DIR=data
